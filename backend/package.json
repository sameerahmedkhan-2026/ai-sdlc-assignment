    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "@smart-todo/contracts": "*",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "vitest": "^5.1.0"
  }
}
